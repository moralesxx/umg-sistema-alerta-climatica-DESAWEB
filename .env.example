# Copie este archivo como ".env" en el servidor y cambie los valores.
# El archivo .env NO se sube a Git (ya está en .gitignore).

# Contraseña del usuario "sa" de SQL Server (mín. 8 caracteres con mayúscula, minúscula, número y símbolo).
SA_PASSWORD=CambieEstaClave_2026!

# Clave secreta del JWT: mínimo 32 caracteres, aleatoria. Ejemplo para generarla:  openssl rand -base64 48
JWT_KEY=CAMBIE_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA_DE_AL_MENOS_32_CARACTERES

# Minutos de validez del token (opcional, por defecto 60).
JWT_EXPIRATION_MINUTES=60

# Contraseña inicial del administrador (admin@alerta.com). Solo se usa si la base de datos está vacía.
ADMIN_PASSWORD=CambieEstaClaveAdmin_2026!

# Simulador de lecturas (opcional).
SIMULADOR_HABILITADO=true
SIMULADOR_INTERVALO=15
