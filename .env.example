# Copie este archivo como ".env" (NO se sube a Git). Cambie TODOS los valores.

# --- JWT (compartido por los servicios; mínimo 32 caracteres):  openssl rand -base64 48
JWT_KEY=CAMBIE_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA_DE_AL_MENOS_32_CARACTERES
JWT_ISSUER=AlertaClimatica.Auth
JWT_AUDIENCE=AlertaClimatica.Client
JWT_EXPIRATION_MINUTES=60

# --- Administrador inicial (admin@alerta.com); solo se usa con la base de Auth vacía
ADMIN_PASSWORD=CambieEstaClaveAdmin_2026!

# --- Contraseñas de bases de datos
AUTH_DB_PASSWORD=CambieAuthDb_2026
COMMUNITY_DB_PASSWORD=CambieCommunityDb_2026
ALERT_DB_PASSWORD=CambieAlertDb_2026
SA_PASSWORD=CambieEstaClave_2026!        # SQL Server (mayúscula, minúscula, número y símbolo)

# --- Publicación
PUBLIC_URL=https://sistema-climatico.example
FRONTEND_PORT=4200
APP_TZ=America/Guatemala

# --- Simulador y datos de demostración (comunidades y sensores de ejemplo en base vacía)
SIMULADOR_HABILITADO=true
SIMULADOR_INTERVALO=15
SEED_DEMO=true
REPORT_MAX_ROWS=20000

# --- Dispositivos (Arduino/ESP32): clave para POST /api/sensors/ingest (mínimo 16 caracteres; vacío = ingesta deshabilitada)
#     Genere una:  openssl rand -hex 24
DEVICE_API_KEY=
