# Copie este archivo como ".env" (NO se sube a Git). Cambie TODOS los valores.

# --- JWT (compartido por los servicios; mínimo 32 caracteres):  openssl rand -base64 48
JWT_KEY=j1GvQnwfqLmLR2bMkbYS0x2FKYs0AaH2L7XNORiPGjM=
JWT_ISSUER=AlertaClimatica.Auth
JWT_AUDIENCE=AlertaClimatica.Client
JWT_EXPIRATION_MINUTES=15          # token de acceso corto; la sesión se renueva sola (refresh token)
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5               # intentos fallidos antes de bloquear la cuenta
LOCK_MINUTES=15

# --- Login con Google y GitHub (OAuth 2.0 / OpenID Connect) — ver docs/OAUTH-OIDC.md ------------------
# Deje un proveedor vacío para deshabilitarlo (su botón no aparece). NUNCA suba el .env real a Git.
# Redirect URI a registrar en cada proveedor:  <PUBLIC_URL>/api/auth/oauth/google/callback   y   .../github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# false (recomendado): una cuenta NUEVA creada por Google/GitHub queda pendiente hasta que un administrador la apruebe.
# true: se activa al instante con el rol mínimo 'Usuario de consulta' (útil para demostraciones).
OAUTH_AUTO_ACTIVATE=false

# --- Administrador inicial (admin@alerta.com); solo se usa con la base de Auth vacía
ADMIN_PASSWORD=CambieEstaClaveAdmin_2026!

# --- Contraseñas de bases de datos
AUTH_DB_PASSWORD=CambieAuthDb_2026
COMMUNITY_DB_PASSWORD=CambieCommunityDb_2026
ALERT_DB_PASSWORD=CambieAlertDb_2026
SA_PASSWORD=CambieEstaClave_2026!        # SQL Server (mayúscula, minúscula, número y símbolo)

# --- Publicación
PUBLIC_URL=https://sistema-climatico.example
FRONTEND_PORT=4200
APP_TZ=America/Guatemala

# --- Simulador y datos de demostración (comunidades y sensores de ejemplo en base vacía)
SIMULADOR_HABILITADO=true
SIMULADOR_INTERVALO=15
SEED_DEMO=true
REPORT_MAX_ROWS=20000

# --- Dispositivos (Arduino/ESP32): clave para POST /api/sensors/ingest (mínimo 16 caracteres; vacío = ingesta deshabilitada)
#     Genere una:  openssl rand -hex 24
DEVICE_API_KEY=

# --- Retención de lecturas (días)
RETENCION_DIAS=30

# --- Notificaciones por correo de las alertas ---------------------------------------------
# Modo prueba (por defecto): los correos se capturan en Mailpit -> http://localhost:8025
# Correo real con Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#   SMTP_USER=tucorreo@gmail.com  SMTP_PASSWORD=<contraseña de aplicación de 16 caracteres>
#   (Cuenta Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Alerta Climática <alertas@sistema-climatico.example>
# Destinatarios iniciales (separados por coma). Se pueden administrar luego en la pantalla "Notificaciones".
NOTIFY_DEFAULT_RECIPIENTS=
NOTIFY_MAX_PER_HOUR=30
MAILPIT_UI_PORT=8025
