# Nginx "de borde" en el VPS (fuera de Docker). Termina HTTPS y reenvía al contenedor frontend (puerto 4200).
# Certificado:  sudo certbot --nginx -d miguate.lat
server {
    listen 80;
    server_name miguate.lat;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name miguate.lat;
    ssl_certificate     /etc/letsencrypt/live/miguate.lat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/miguate.lat/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:4200;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # sobrescribe: el cliente no puede falsificarlo
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
}
