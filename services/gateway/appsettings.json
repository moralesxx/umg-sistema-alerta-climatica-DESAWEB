{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" } },
  "AllowedHosts": "*",
  "Jwt": { "Issuer": "AlertaClimatica.Auth", "Audience": "AlertaClimatica.Client" },
  "Cors": { "AllowedOrigins": [ "http://localhost:4200" ] },
  "RateLimit": { "DevicePerMinute": 300, "LoginPerMinute": 10, "GlobalPerMinute": 600 },
  "ReverseProxy": {
    "Routes": {
      "auth-login":    { "ClusterId": "auth", "AuthorizationPolicy": "anonymous", "RateLimiterPolicy": "login", "Match": { "Path": "/api/auth/login", "Methods": [ "POST" ] } },
      "auth-register": { "ClusterId": "auth", "AuthorizationPolicy": "anonymous", "RateLimiterPolicy": "login", "Match": { "Path": "/api/auth/register", "Methods": [ "POST" ] } },
      "sensors-ingest": { "ClusterId": "sensor", "AuthorizationPolicy": "anonymous", "RateLimiterPolicy": "device", "Match": { "Path": "/api/sensors/ingest", "Methods": [ "POST" ] } },
      "auth":        { "ClusterId": "auth",      "AuthorizationPolicy": "default", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "communities": { "ClusterId": "community", "AuthorizationPolicy": "default", "Match": { "Path": "/api/communities/{**catch-all}" } },
      "sensors":     { "ClusterId": "sensor",    "AuthorizationPolicy": "default", "Match": { "Path": "/api/sensors/{**catch-all}" } },
      "alerts":      { "ClusterId": "alert",     "AuthorizationPolicy": "default", "Match": { "Path": "/api/alerts/{**catch-all}" } },
      "reports":     { "ClusterId": "report",    "AuthorizationPolicy": "default", "Match": { "Path": "/api/reports/{**catch-all}" } },
      "audit":       { "ClusterId": "audit",     "AuthorizationPolicy": "default", "Match": { "Path": "/api/audit/{**catch-all}", "Methods": [ "GET" ] } }
    },
    "Clusters": {
      "auth":      { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "d1": { "Address": "http://auth-service:8080/" } } },
      "community": { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "d1": { "Address": "http://community-service:8080/" } } },
      "sensor":    { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "d1": { "Address": "http://sensor-service:8080/" } } },
      "alert":     { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "d1": { "Address": "http://alert-service:8080/" } } },
      "report":    { "HttpRequest": { "ActivityTimeout": "00:01:30" }, "Destinations": { "d1": { "Address": "http://report-service:8000/" } } },
      "audit":     { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "d1": { "Address": "http://audit-service:8000/" } } }
    }
  }
}
