{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "outDir": "dist", "rootDir": "src",
    "strict": true, "strictPropertyInitialization": false, "esModuleInterop": true, "skipLibCheck": true,
    "emitDecoratorMetadata": true, "experimentalDecorators": true, "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
